rules_version = '2';
// Reglas de seguridad — Formulario Operativo Luna GI
// Publícalas en: Consola Firebase → Firestore Database → Reglas
service cloud.firestore {
  match /databases/{database}/documents {

    // Bitácora de uso: cualquier app puede REGISTRAR (p. ej. el Cotizador,
    // que no tiene login), pero solo usuarios autenticados leen o limpian
    match /bitacora/{doc} {
      allow create: if true;
      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    // Vehículos: crear salida y actualizar para confirmar entrega
    match /vehiculos/{doc} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Registros de horas de maquinaria: solo crear y leer (inmutables)
    match /maquinaria/{doc} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // Comprobaciones de gastos: solo crear y leer (inmutables)
    match /gastos/{doc} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // Todo lo demás: bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
